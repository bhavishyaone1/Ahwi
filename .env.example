# AETHER — Environment Configuration Template
# Copy to .env or set in deployment environment

# ==========================================
# Backend Settings (FastAPI / PyTorch / ML)
# ==========================================
# Operational Mode: "REAL" (with live ECMWF/GFS feeds) or "DEMO" (offline synthetic scenarios)
AETHER_DATA_MODE=DEMO

# Target analysis grid resolution in degrees (0.25° ~ 27 km)
TARGET_GRID_RESOLUTION=0.25

# Database URL (SQLite for local zero-friction execution, or PostgreSQL/PostGIS)
DATABASE_URL=sqlite:///./backend/aether.db

# API Host & Port
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# ==========================================
# Frontend Settings (Next.js)
# ==========================================
# Backend API base URL accessible by browser clients
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
